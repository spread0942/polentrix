# Ollama model to use (pull on first start)
OLLAMA_MODEL=qwen2.5:0.5b

# Postgres
POSTGRES_USER=polentrix
POSTGRES_PASSWORD=polentrix
POSTGRES_DB=polentrix

# API
PORT=8080
OLLAMA_BASE_URL=http://ollama:11434
# Host-local API default; Compose overrides this to use the db service
DATABASE_URL=postgres://polentrix:polentrix@localhost:5432/polentrix?sslmode=disable
DEFAULT_SYSTEM_PROMPT=You are Polentrix, a helpful local AI assistant.
DEFAULT_TEMPERATURE=0.7

# Frontend (build-time for Docker web service; use http://localhost:8080 for local Vite)
VITE_API_BASE_URL=
